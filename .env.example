# ==============================================================================
# Government Welfare Scheme Navigator - Environment Configuration
# ==============================================================================

# Project Details
PROJECT_NAME="Scheme Management & Eligibility API"
VERSION="1.0.0"

# Database Configuration (PostgreSQL in Docker / Local)
# For local SQLite development, use: sqlite:///./scheme.db
DATABASE_URL=postgresql+psycopg://scheme_user:scheme_password@localhost:5432/scheme_db

# Security & JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_key_123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEV_MODE=true

# Storage Configuration: "cloudinary" (Default, 25GB free) or "s3"
STORAGE_PROVIDER=cloudinary

# Cloudinary Storage Credentials (Required if STORAGE_PROVIDER=cloudinary)
# Sign up free at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively use connection string:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# MinIO / S3 Object Storage (Required if STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=scheme-documents
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRY_SECONDS=3600

# AI Models & Providers
LLM_PROVIDER=gemini # "gemini" | "groq" | "agy"

# Google Gemini API
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Groq AI Provider (Ultra-fast failover inference)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Local CLI AI (Google Antigravity agy fallback)
AGY_MODEL=gemini-3.6-flash

# Valkey / Redis Caching (Aiven for Valkey / Redis)
# Schemes change rarely — default TTL is 24 hours.
VALKEY_URL=valkeys://default:<password>@<host>:<port>
# CACHE_TTL_SECONDS=86400

# LangSmith Observability & Tracing (Optional)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT="schemex"


